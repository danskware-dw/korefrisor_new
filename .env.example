# Kodeord til /admin
ADMIN_PASSWORD=skiftmig

# App Postgres (Neon). Never point TEST_DATABASE_URL at this database.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Isolated Postgres for concurrency tests only.
# TEST_DATABASE_URL=

# Valgfrit. Kørselsruter hentes fra OSRM's åbne server, hvis intet er sat her.
# Kører du siden i drift med mange bookinger, bør du bruge din egen OSRM-server
# og skrive adressen her.
# OSRM_BASE_URL=https://router.project-osrm.org

# Valgfrit: Vipps MobilePay Online (ePayment). Uden nøgler betaler kunden
# manuelt til MobilePay-nummeret i Indstillinger.
# MOBILEPAY_CLIENT_ID=
# MOBILEPAY_CLIENT_SECRET=
# MOBILEPAY_SUBSCRIPTION_KEY=
# MOBILEPAY_MSN=
# MOBILEPAY_ENV=test
# MOBILEPAY_WEBHOOK_SECRET=

# Cron (Vercel Authorization: Bearer …)
# CRON_SECRET=

# Rigtig e-mail via Resend. Uden nøgle skrives beskederne kun i serverloggen.
# RESEND_API_KEY=
# RESEND_FROM=Kørefrisøren <kontakt@ditdomaene.dk>
